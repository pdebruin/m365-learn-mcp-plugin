{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.4",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Microsoft Learn",
        "websiteUrl": "https://learn.microsoft.com",
        "privacyUrl": "https://go.microsoft.com/fwlink/?LinkId=521839",
        "termsOfUseUrl": "https://learn.microsoft.com/en-us/legal/termsofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Learn Docs${{APP_NAME_SUFFIX}}",
        "full": "Microsoft Learn Documentation Assistant"
    },
    "description": {
        "short": "Search and browse Microsoft Learn documentation from Copilot Chat",
        "full": "A Copilot agent that searches Microsoft Learn documentation, finds code samples, and fetches full article content. Powered by the Microsoft Learn MCP Server. Ask about any Microsoft or Azure technology and get answers grounded in official documentation."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}