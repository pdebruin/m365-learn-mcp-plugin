{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.4",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Microsoft Learn",
        "websiteUrl": "https://learn.microsoft.com",
        "privacyUrl": "https://go.microsoft.com/fwlink/?LinkId=521839",
        "termsOfUseUrl": "https://learn.microsoft.com/en-us/legal/termsofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Learn Docs${{APP_NAME_SUFFIX}}",
        "full": "Microsoft Learn Documentation Assistant"
    },
    "description": {
        "short": "Get answers grounded in official Microsoft Learn documentation.",
        "full": "Ask about Microsoft products and services and get answers grounded in trusted up-to-date Microsoft Learn product documentation with citations."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}